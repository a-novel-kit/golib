{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>a-novel-kit/workflows//renovate/library#v1.45.1",
    "github>a-novel-kit/workflows//renovate/protobuf#v1.45.1"
  ],
  "packageRules": [
    {
      "matchFileNames": ["buf.mod"],
      "additionalBranchPrefix": "buf-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": [
          "rm -f buf.sum",
          "go get -modfile=buf.mod -tool github.com/bufbuild/buf/cmd/buf",
          "rm -rf grpcf/proto/gen",
          "go tool -modfile=buf.mod buf generate",
          "go tool -modfile=buf.mod buf format -w",
          "go tool -modfile=buf.mod buf dep update"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["npm"],
      "postUpgradeTasks": {
        "commands": ["pnpm format:prettier"],
        "executionMode": "branch"
      }
    }
  ]
}
